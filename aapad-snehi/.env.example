# Frontend
VITE_API_URL=http://localhost:8000
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Backend
AAPAD_DATABASE_URL=sqlite:///./data/aapad_snehi.db
AAPAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AAPAD_ENABLE_LIVE_ADAPTERS=false
AAPAD_RELIEFWEB_APPNAME=Aapad-Snehi
AAPAD_SERPER_API_KEY=
AAPAD_GOVERNMENT_HOSTS=mausam.imd.gov.in,api.imd.gov.in,cap-sources.s3.amazonaws.com,sachet.ndma.gov.in,ndma.gov.in
AAPAD_SACHET_POLL_SECONDS=300

# Authenticated, read-only Bluesky helper search (backend only)
# Use a Bluesky app password, never a normal reusable account password.
AAPAD_BLUESKY_EMAIL=your-bluesky-email
AAPAD_BLUESKY_APP_PASSWORD=your-bluesky-app-password
AAPAD_BLUESKY_QUERY=floods in india
AAPAD_BLUESKY_MAX_POSTS=10
AAPAD_BLUESKY_SENTIMENT_ENABLED=true
AAPAD_BLUESKY_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
AAPAD_BLUESKY_SENTIMENT_MAX_POSTS=10
AAPAD_MAX_UPLOAD_MB=6

# Active image verification and storage (backend only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_CALLS_PER_HOUR=20
CLOUDINARY_KEY=
# Optional alternative to one full CLOUDINARY_KEY URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REVIEW_URL_SECONDS=300

# Hugging Face token used by Bluesky sentiment and retained image-model experiments
AAPAD_HF_TOKEN=
AAPAD_HF_CAPTION_MODEL=Qwen/Qwen3-VL-2B-Instruct:featherless-ai

# Optional local trained-model demo. The default discovers the sibling handoff folder.
# Use an absolute trusted server-side path elsewhere; clients cannot override it.
# AAPAD_ML_MODEL_ROOT=C:\path\to\disaster_research
AAPAD_ML_MAX_PAYLOAD_BYTES=3000000
