# SIMULATED / DEMO ONLY. Copy desired values into an ignored .env file.
AAPAD_EDGE_MQTT_ENABLED=false
AAPAD_EDGE_MQTT_HOST=localhost
AAPAD_EDGE_MQTT_PORT=1883
AAPAD_EDGE_MQTT_TOPIC=aapadsnehi/edge/+/telemetry
